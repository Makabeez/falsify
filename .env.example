# Meta Model API key (dev.meta.ai -> API keys). Only needed for live checks, `falsify check` / `extract` / corpus runs.
MODEL_API_KEY=

# Optional model overrides
# FALSIFY_MODEL=muse-spark-1.3
# FALSIFY_VIDEO_MODEL=muse-spark-1.2
# FALSIFY_REASONING=medium        # minimal|low|medium|high|xhigh|max; medium chosen by `falsify sweep` (docs/effort_sweep.md)
# FALSIFY_API_TIMEOUT=150         # seconds per Meta API call
# FALSIFY_API_RETRIES=1

# Web app (deploy/run-web.sh reads this file)
# FALSIFY_PORT=8097
# FALSIFY_LIVE=1                  # 0 pauses live checks; the examples keep working
# FALSIFY_PER_IP_PER_HOUR=6
# FALSIFY_DAILY_LIMIT=150         # live checks per day across all visitors; caps API spend
# FALSIFY_WORKERS=2
# FALSIFY_JOB_TIMEOUT=540         # seconds before a stuck live check is reported as failed
# FALSIFY_CACHE=web_cache
